# Optional OpenAI-compatible chat completions provider.
# If LLM_API_KEY is not set, the built-in deterministic policy engine is used.
LLM_API_KEY=your-openai-api-key
LLM_MODEL=gpt-4o-mini
LLM_API_URL=https://api.openai.com/v1/chat/completions

# Optional OpenAI-compatible audio endpoints. SPEECH_API_KEY falls back to LLM_API_KEY.
SPEECH_API_KEY=your-speech-api-key
SPEECH_API_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
TTS_MODEL=tts-1

# Supabase server persistence is enabled only when both URL and service-role key are set.
# Keep the service-role key server-only; never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional local JSON path. By default data is stored in .data/relay-agent.json.
LOCAL_STORE_PATH=

# Optional provider webhook protection and canonical public URL.
TELEPHONY_WEBHOOK_SECRET=your-webhook-secret
TWILIO_AUTH_TOKEN=your-twilio-auth-token
APP_BASE_URL=https://localhost:3000
